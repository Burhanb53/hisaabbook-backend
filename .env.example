# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

PORT=5000
NODE_ENV=development

# Long random string (>= 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated web origins allowed by CORS (leave empty for mobile-only)
CORS_ORIGINS=

